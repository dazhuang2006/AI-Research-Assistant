# 嵌入服务：硅基流动（OpenAI 兼容接口）
EMBEDDING_API_KEY=sk-your-siliconflow-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32

# 对话服务：DeepSeek 官方 API
LLM_API_KEY=sk-your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# MySQL（会话记忆）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=research_assistant
MYSQL_CONNECT_TIMEOUT=3

# Milvus（向量库）
MILVUS_URI=http://127.0.0.1:19530
MILVUS_CHUNK_COLLECTION=document_chunks
MILVUS_DOC_COLLECTION=document_meta
MILVUS_TIMEOUT=3
VECTOR_DIM=1024

# API 输入与上传限制
MAX_QUERY_LENGTH=4000
MAX_TOP_K=50
MAX_DOC_IDS=100
MAX_UPLOAD_SIZE_MB=50
MAX_DOCUMENT_CHUNKS=5000
